/* Gruvbox Dark theme for Rofi */

* {
    background: #282828;
    background-alt: #3c3836;
    foreground: #ebdbb2;
    selected: #fe8019;
    active: #83a598;
    urgent: #cc241d;
    
    font: "JetBrainsMono Nerd Font 14";
    border-color: #504945;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: true;
    width: 100%;
    height: 100%;
    padding: 0;
    background-color: @background;
}

mainbox {
    padding: 100px 200px;
    spacing: 50px;
    children: [inputbar, listview];
}

inputbar {
    padding: 15px;
    border-radius: 10px;
    background-color: @background-alt;
    children: [prompt, entry];
}

prompt {
    margin: 0 10px 0 0;
    text-color: @selected;
}

entry {
    placeholder: "Search";
    placeholder-color: @foreground;
    text-color: @foreground;
}

listview {
    lines: 8;
    columns: 4;
    spacing: 15px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    padding: 20px 10px;
    border-radius: 10px;
    orientation: vertical;
    spacing: 10px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @background;
}

element-icon {
    size: 64px;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
}
